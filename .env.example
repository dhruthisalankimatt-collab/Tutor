# ==============================================================================
# Smruthi's Tutor - Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# ------------------------------------------------------------------------------
# Encryption Key (lib/crypto.ts)
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=your-64-character-hex-encryption-key

# ------------------------------------------------------------------------------
# Groq AI Provider Keys (Individual keys per agent + vision)
# ------------------------------------------------------------------------------
GROQ_API_KEY_AGENT1=your-groq-api-key-for-agent-1
GROQ_API_KEY_AGENT2=your-groq-api-key-for-agent-2
GROQ_API_KEY_AGENT3=your-groq-api-key-for-agent-3
GROQ_API_KEY_VISION=your-groq-api-key-for-vision
GROQ_API_KEY=your-default-groq-api-key

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
